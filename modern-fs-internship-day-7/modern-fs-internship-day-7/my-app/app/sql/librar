SELECT * FROM members;
SELECT * FROM authors;
SELECT * FROM books;
SELECT * FROM librarians;
SELECT * FROM book_issues;
SELECT * FROM payments;

SELECT
    m.member_name,
    b.title AS book_title,
    a.author_name,
    l.librarian_name,
    bi.issue_date,
    bi.due_date,
    bi.return_date,
    p.amount AS fine_amount,
    p.payment_mode
FROM book_issues bi
JOIN members m
    ON bi.member_id = m.member_id
JOIN books b
    ON bi.book_id = b.book_id
JOIN authors a
    ON b.author_id = a.author_id
JOIN librarians l
    ON bi.librarian_id = l.librarian_id
JOIN payments p
    ON bi.issue_id = p.issue_id;